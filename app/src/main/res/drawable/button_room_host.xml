<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <corners android:radius="8dp" />
            <solid android:color="#55314A58" />
            <stroke android:width="1dp" android:color="#5575919A" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="8dp" />
            <gradient android:angle="270" android:startColor="#143F68" android:endColor="#0B263D" />
            <stroke android:width="1dp" android:color="#D7F1C45B" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="8dp" />
            <gradient android:angle="270" android:startColor="#1B5B85" android:centerColor="#123F63" android:endColor="#0A253D" />
            <stroke android:width="1dp" android:color="#A8F1C45B" />
        </shape>
    </item>
</selector>
