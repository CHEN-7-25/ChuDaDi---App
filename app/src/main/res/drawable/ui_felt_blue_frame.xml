<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <bitmap
            android:src="@drawable/table_felt_green"
            android:tileMode="repeat" />
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="180"
                android:startColor="#F0061B13"
                android:centerColor="#D8195D28"
                android:endColor="#F0061B13" />
        </shape>
    </item>
    <item android:bottom="10dp" android:left="10dp" android:right="10dp" android:top="10dp">
        <shape android:shape="rectangle">
            <solid android:color="#00000000" />
            <stroke android:width="2dp" android:color="#416BFF" />
        </shape>
    </item>
</layer-list>
