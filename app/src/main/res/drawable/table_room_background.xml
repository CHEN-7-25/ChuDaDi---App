<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <bitmap
            android:src="@drawable/table_felt_green"
            android:tileMode="repeat" />
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="180"
                android:startColor="#F2081C16"
                android:centerColor="#D428684F"
                android:endColor="#F00E261E" />
        </shape>
    </item>
    <item android:top="10dp" android:left="10dp" android:right="10dp" android:bottom="10dp">
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <stroke android:width="2dp" android:color="#BDF1C45B" />
            <solid android:color="#12000000" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="90"
                android:startColor="#6605120F"
                android:centerColor="#0005120F"
                android:endColor="#6605120F" />
        </shape>
    </item>
</layer-list>
